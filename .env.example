# Django
DJANGO_SECRET_KEY=degistir-bunu
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Anonim oy anahtarı tuzu — production'da mutlaka farklı olsun
VOTER_KEY_SALT=degistir-bunu-da

# Supabase — uygulama çalışırken (Transaction pooler, port 6543)
# Boş bırakılırsa yerelde SQLite kullanılır.
# postgresql://postgres.<PROJE_REF>:<PAROLA>@aws-1-<BOLGE>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase — sadece migration için (Session pooler, port 5432)
# postgresql://postgres.<PROJE_REF>:<PAROLA>@aws-1-<BOLGE>.pooler.supabase.com:5432/postgres
# Not: yeni Supabase projeleri aws-1, eski projeler aws-0 önekini kullanır.
DATABASE_URL_DIRECT=
